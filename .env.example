# ─────────────────────────────────────────────────────────────────
#  SEARCHOps — Environment Variables Template
#  Copy to .env and fill in all values before running the platform.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=searchops
APP_VERSION=0.1.0
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
APP_DEBUG=false
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FORMAT=json          # json | console

# ── API Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false             # true only in development
API_ROOT_PATH=               # set if behind a reverse proxy (e.g. /api)
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database — PostgreSQL ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=searchops
POSTGRES_USER=searchops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_ECHO=false

# ── Cache — Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ── Vector Store — Qdrant ─────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME
QDRANT_PREFER_GRPC=true
QDRANT_TIMEOUT=30

# ── Graph Database — Neo4j ────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=searchops
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# ── LLM Providers ─────────────────────────────────────────────────
# Set LLM_DEFAULT_PROVIDER to one of:
#   openai | anthropic | google | nvidia | bedrock | zhipu
LLM_DEFAULT_PROVIDER=google              # gemini-2.0-flash is free in AI Studio

# ── OpenAI ────────────────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_ORG_ID=                               # optional
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini          # cheapest OpenAI — avoid gpt-4o on free
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # 5x cheaper than large

# ── Anthropic ─────────────────────────────────────────────────────
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5  # cheapest Claude; claude-3-5-haiku also ok

# ── Google AI Studio (Gemini) ─────────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza-CHANGE_ME
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash     # FREE in AI Studio (15 RPM, 1M TPD)

# ── NVIDIA NIM ────────────────────────────────────────────────────
# Get key: https://build.nvidia.com  (free tier available)
NVIDIA_API_KEY=nvapi-CHANGE_ME
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Amazon Bedrock ────────────────────────────────────────────────
# IAM user must have AmazonBedrockFullAccess policy
# Get credentials: https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=AKIA-CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
BEDROCK_DEFAULT_MODEL=amazon.nova-lite-v1:0   # cheapest Bedrock model

# ── Zhipu AI / Z.AI (GLM) ────────────────────────────────────────
# Get key: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=CHANGE_ME
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4-flash               # 100% free on Z.AI — no quota cost

# ── Scraping ──────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-CHANGE_ME
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ── Observability — OpenTelemetry ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc          # grpc | http/protobuf
OTEL_SERVICE_NAME=searchops
OTEL_SERVICE_VERSION=0.1.0
OTEL_TRACES_EXPORTER=otlp                 # otlp | console | none
OTEL_METRICS_EXPORTER=otlp               # otlp | prometheus | console | none
OTEL_LOGS_EXPORTER=otlp                  # otlp | console | none
OTEL_ENABLED=true

# ── Observability — Langfuse ──────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_DEBUG=false

# ── Observability — Prometheus ────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_PATH=/metrics

# ── Authentication ────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH2_ENABLED=false
OAUTH2_PROVIDER=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# ── Security ──────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
CONTENT_SECURITY_POLICY=default-src 'self'

# ── Scraping Policies ─────────────────────────────────────────────
SCRAPING_ALLOWED_DOMAINS=                  # comma-separated, empty = all allowed
SCRAPING_REQUEST_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_CACHE_TTL=3600
SCRAPING_RATE_LIMIT_RPS=5

# ── Agent Budget (free-tier safe) ────────────────────────────────
AGENT_MAX_TOKEN_BUDGET=10000       # was 100000 — protects all provider quotas
AGENT_MAX_COST_USD=0.10            # was 10.0   — hard spend cap per job
AGENT_MAX_RECURSION_DEPTH=8        # was 25     — fewer LLM hops
AGENT_MAX_PARALLEL_AGENTS=2        # was 10     — fewer concurrent calls
AGENT_EXECUTION_TIMEOUT_SECONDS=180  # was 600
AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# ── LLM token limits ──────────────────────────────────────────────
LLM_DEFAULT_MAX_TOKENS=1024        # max completion tokens per LLM call
LLM_MAX_PROMPT_CHARS=6000          # hard char cap applied before every call

# ── Knowledge Graph ───────────────────────────────────────────────
KG_EMBEDDING_DIMENSION=3072
KG_SIMILARITY_THRESHOLD=0.85
KG_COMMUNITY_RESOLUTION=1.0
KG_MAX_HOPS=3

# ── Search APIs ───────────────────────────────────────────────────
TAVILY_API_KEY=tvly-CHANGE_ME
SERPER_API_KEY=CHANGE_ME
BING_SEARCH_API_KEY=CHANGE_ME
BRAVE_SEARCH_API_KEY=BSA-CHANGE_ME
ARXIV_MAX_RESULTS=20
GITHUB_TOKEN=ghp_CHANGE_ME

# ── Bright Data (Premium Tier) ────────────────────────────────────────────────
# Control panel: https://brightdata.com/cp
# All BD features default to OFF. Enable via feature flags when credentials are set.
BRIGHTDATA_API_KEY=CHANGE_ME                          # Bearer token for SERP + Dataset APIs
BRIGHTDATA_CUSTOMER_ID=brd-customer-CHANGE_ME         # Your account customer ID
BRIGHTDATA_ZONE_SERP=serp                             # Zone name for Google SERP product
BRIGHTDATA_ZONE_UNLOCKER=unlocker                     # Zone name for Web Unlocker product
BRIGHTDATA_ZONE_SCRAPING_BROWSER=scraping_browser     # Zone name for Cloud Scraping Browser
BRIGHTDATA_ZONE_PASSWORD=CHANGE_ME                    # Zone password (from Bright Data CP)
