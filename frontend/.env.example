# SEARCHOps Frontend Environment
# Copy to .env.local (gitignored) and fill in values.

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Clerk publishable key (public by design). Must match CLERK_PUBLISHABLE_KEY
# in the API's .env. Never put a Clerk SECRET key or the API key here:
# anything in a VITE_ variable is compiled into the public bundle.
VITE_CLERK_PUBLISHABLE_KEY=
